# Compte Gmail utilisé pour envoyer les emails du formulaire de contact
EMAIL_USER=votre.compte@gmail.com
# Mot de passe d'application Gmail (https://myaccount.google.com/apppasswords), pas le mot de passe normal
EMAIL_PASS=
# (Optionnel) Adresse qui reçoit les messages ; par défaut EMAIL_USER
CONTACT_TO=
# URL publique du site (SEO : sitemap, balises canoniques, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.nastrans.tn
